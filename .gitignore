###############################################################################
# Homepage
###############################################################################

# Logs generados automáticamente por Homepage
docker/homepage/config/logs/

###############################################################################
# PKI / Certificates
###############################################################################

# Root CA material
security/pki/root-ca/

# Generated identities and certificates for services
security/pki/services/
!security/pki/services/
!security/pki/services/*/
!security/pki/services/*/README.md
!security/pki/services/*/*.cnf

# Common certificate and key formats
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx
*.der
*.srl
*.old

###############################################################################
# Jarvis Backup Standard (JBS)
###############################################################################

# Generated backup archives
backups/*/daily/
backups/*/weekly/
backups/*/monthly/

# Backup artifacts
*.tar.zst
*.tar.zst.sha256
*.zst.tmp
*.backup.tmp

# Temporary restoration data
backups/restore-work/
